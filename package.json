{
  "name": "wiki-editor",
  "version": "1.12.0",
  "private": true,
  "description": "Lightweight high-performance Markdown desktop wiki editor for Windows",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.wiki-editor.app",
    "productName": "wiki-editor",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "build/icon.png"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "win": {
      "target": "dir",
      "icon": "build/icon.ico"
    }
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-code-block": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-list": "^3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/markdown": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "iconv-lite": "^0.7.3",
    "jsdom": "^31.0.1",
    "lucide-react": "^1.73.0",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-parse": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-react": "^8.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  }
}
